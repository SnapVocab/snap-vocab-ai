# Environment of the RunPod Serverless (load-balancing) endpoint. There is no .env
# file inside the image: set these on the endpoint, plus SERVICE_TOKEN (secret, must
# match ai-service.service-token in the backend).

# Load balancer contract: the app and its /ping must be on these ports.
PORT=8000
PORT_HEALTH=8000

DEVICE=cuda
CORS_ORIGINS=[]
MAX_UPLOAD_MB=10

# Must be the model baked into the image (Dockerfile ARG FLORENCE_MODEL_ID).
FLORENCE_MODEL_ID=microsoft/Florence-2-large
FLORENCE_MAX_NEW_TOKENS=1024
FLORENCE_NUM_BEAMS=3

ENABLE_TILED_OD=true
ENABLE_SELF_GROUNDING=true
# Measured on real phone photos: these two produced nearly all the wrong labels
# (13 of 18 on one photo) and cost +60-80% time. CLIP is not even loaded without them.
ENABLE_BASE_VOCAB=false
ENABLE_EXTRA_VOCAB=false
STRICT_DICTIONARY_FILTER=false
REQUIRE_DICTIONARY_LABELS=true

# The async scan flow never reads the annotated image; it only adds upload time.
RETURN_ANNOTATED_IMAGE=false
